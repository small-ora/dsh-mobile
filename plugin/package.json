{
  "name": "dsh-mobile-plugin",
  "version": "0.1.11",
  "description": "dsh-mobile: DSH 侧边栏入口 + 主机面板 + 独立网关（口令/设备 token、RPC 代理、HTTP 长轮询流中心、文件传输）",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "files": [
    "index.mjs",
    "client.js",
    "admin.html",
    "admin.js",
    "cordis.patch.yml",
    "gateway/"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
